{
  "schema_version": "1.0",
  "source_file": "op_family.md",
  "regex_dialect": "Python/PCRE-style regular expressions",
  "matching_guidance": {
    "recommended_flags": [
      "case_insensitive",
      "dot_matches_newline"
    ],
    "normalization": [
      "lowercase text before matching when possible",
      "collapse repeated whitespace to one space for formula-like text",
      "optionally strip namespaces such as torch., aten::, prim::, nn., nn.functional.",
      "evaluate rules by ascending priority; first confident match wins"
    ],
    "confidence_hint": "operator_patterns match names or API calls; formula_patterns match semantic formula shapes and may intentionally be broader."
  },
  "disambiguation_rules": [
    {
      "when": "attention also matches matmul or softmax",
      "choose": "attention"
    },
    {
      "when": "fusion_simple also matches matmul, norm, or elementwise activation",
      "choose": "fusion_simple"
    },
    {
      "when": "pooling also matches reduction",
      "choose": "pooling"
    },
    {
      "when": "scan also matches reduction",
      "choose": "scan"
    },
    {
      "when": "convolution also matches matmul through im2col/unfold",
      "choose": "convolution"
    },
    {
      "when": "elementwise_complex also matches elementwise",
      "choose": "elementwise_complex"
    }
  ],
